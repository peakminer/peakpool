# Copy this to `.env`, then run:
#   docker compose up -d
#
# Wallet address, balance, sending and backup:  ./p1d help
#
# It works as-is for a quick test. For real mining set WALLET_ADDRESS to your
# own wallet (and change MINING_KEY on a shared machine).

# ── Your wallet ─────────────────────────────────────────────────────────────
# Where mined blocks pay. EMPTY = the node's own auto-created wallet (safe
# default; see the README on backing up wallet.key). Set your own o1… address
# to pay an external wallet instead.
WALLET_ADDRESS=

# ── Node RPC token ──────────────────────────────────────────────────────────
# REQUIRED — there is no built-in default, the stack will not start without it.
# Shared between the node and the pool: the two services read this SAME value,
# so any non-empty string works and they always match. Port 9601 is never
# published to the host, so it stays inside the compose network. The value below
# is a placeholder, not a secret — replace it, especially on a shared machine:
#   openssl rand -hex 32
MINING_KEY=change-me-to-any-random-secret

# ── Optional tuning ─────────────────────────────────────────────────────────
# Cores for the node. 0 = unlimited. Proving is all-core on the critical path,
# so give it the machine unless you share the box.
NODE_CPUS=0

# Vardiff floor, in EXPECTED HASHES per share (not Bitcoin pdiff). A miner that
# declares its hashrate over SV2 opens at the right difficulty regardless; this
# only binds below that.
MIN_SHARE_DIFFICULTY=1000000
