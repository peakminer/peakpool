# Copy this to `.env`, set WALLET_ADDRESS + MINING_KEY, then run:
#   docker compose up -d
#
# Wallet address, balance, sending and backup:  ./p1d help

# ── Your wallet ─────────────────────────────────────────────────────────────
# Where mined blocks pay. REQUIRED — the coinbase pays this o1… address directly
# (non-custodial; the pool never holds your coins). Bring your own wallet: create
# one in the ParanO(1)d desktop wallet/GUI and paste its o1… address here. The
# node's mining credential can no longer expose a wallet to the pool, so there
# is no auto-default.
WALLET_ADDRESS=

# ── Node RPC token ──────────────────────────────────────────────────────────
# REQUIRED by the node — the stack will not start without it. It authorises the
# node's RPC for any REMOTE client. The co-located pool does NOT use it: sharing
# the node's netns, it reaches the RPC on loopback, which the node grants full
# access with no credential. Port 9601 is never published to the host, so it
# stays inside the compose network. Must be at least 16 characters. The value
# below is a placeholder, not a secret — replace it, especially on a shared host:
#   openssl rand -hex 32
MINING_KEY=change-me-to-any-random-secret

# ── Optional tuning ─────────────────────────────────────────────────────────
# Cores for the node. 0 = unlimited. Proving is all-core on the critical path,
# so give it the machine unless you share the box.
NODE_CPUS=0

# Vardiff floor, in EXPECTED HASHES per share (not Bitcoin pdiff). A miner that
# declares its hashrate over SV2 opens at the right difficulty regardless; this
# only binds below that.
MIN_SHARE_DIFFICULTY=1000000
